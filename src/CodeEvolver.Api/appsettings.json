{
  "Storage": {
    "Provider": "mysql"
  },
  "Agent": {
    "Provider": "copilot",
    "Copilot": {
      "Executable": "copilot",
      "TimeoutMinutes": 20,
      "PublishChanges": false,
      "ReadOnly": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
